# HTTP port used by the application and Docker/Coolify
PORT=8080

# Use the part after jdbc: (the application adds the jdbc: prefix).
MYSQL_URL=mysql://localhost:3306/kickevent
MYSQL_USER=kickevent
MYSQL_PASSWORD=change-me

# Base64-encoded key with at least 64 decoded bytes for HS512.
# Generate one with: openssl rand -base64 64
JWT_SECRET=replace-with-a-base64-encoded-64-byte-secret

# Browser origin allowed by the backend CORS configuration.
FRONTEND_ORIGIN=http://localhost:3000
